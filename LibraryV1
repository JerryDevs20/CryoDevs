			else
				onChanged("Text")
				Source.Changed:Connect(onChanged)
			end

			function getData.Set(_, displayValue)
				Source.Text = tostring(displayValue)
			end
			function getData.Get(_)
				return Source.Text
			end
			function getData.Log(_, displayValue)
				Source.Text = Source.Text .. "[*] " .. tostring(displayValue) .. "\n"
			end

			return getData, secondaryClone
		end
		function data.AddHorizontalAlignment(_)
			local addButtonData = {}
			local secondaryParent = Prefabs:FindFirstChild("HorizontalAlignment"):Clone()

			secondaryParent.Parent = parent

			function addButtonData.AddButton(_, ...)
				local instanceData = { data:AddButton(...) }

				if typeof(instanceData[1]) ~= "table" then
					local instance = instanceData[1]

					instance.Parent = secondaryParent

					return instance
				end

				local result = instanceData[1]
				local instance = instanceData[2]

				instance.Parent = secondaryParent

				return result, instance
			end

			return addButtonData, secondaryParent
		end
		function data.AddFolder(_, textFlag)
			local kData = {}
			local text = tostring(textFlag or "New Folder")
			local buttonContainer = Prefabs:FindFirstChild("Folder"):Clone()
			local Button = buttonContainer:FindFirstChild("Button")
			local Objects = buttonContainer:FindFirstChild("Objects")
			local toggle = Button:FindFirstChild("Toggle")

			buttonContainer.ZIndex = buttonContainer.ZIndex + sum * 10
			Button.ZIndex = Button.ZIndex + sum * 10
			Objects.ZIndex = Objects.ZIndex + sum * 10
			toggle.ZIndex = toggle.ZIndex + sum * 10
			Button:GetChildren()[1].ZIndex = Button:GetChildren()[1].ZIndex + sum * 10
			buttonContainer.Parent = parent
			Button.Text = "      " .. text
			spawn(function()
				while true do
					if Button and Button:GetChildren()[1] then
						Button:GetChildren()[1].ImageColor3 = capturedFlagData.main_color
					end

					RunService.Heartbeat:Wait()
				end
			end)

			local function handler()
				local sum = 25

				for _, item in next, Objects:GetChildren() do
					if not item:IsA("UIListLayout") then
						sum = sum + item.AbsoluteSize.Y + 5
					end
				end

				return sum
			end

			local flag = false

			Button.MouseButton1Click:Connect(function()
				if not flag then
					handleInstanceProperties(toggle, {
						Rotation = 90
					}, capturedFlagData.tween_time)
					Objects.Visible = true
				else
					handleInstanceProperties(toggle, {
						Rotation = 0
					}, capturedFlagData.tween_time)
					Objects.Visible = false
				end

				flag = not flag
			end)
			spawn(function()
				while true do
					handleInstanceProperties(buttonContainer, {
						Size = UDim2.new(1, 0, 0, flag and handler() or 20)
					}, capturedFlagData.tween_time)
					wait()
				end
			end)

			for k, item in next, data do
				kData[k] = function(...)
					local instanceData = { item(...) }

					if typeof(instanceData[1]) ~= "table" then
						local instance = instanceData[1]

						instance.Parent = Objects

						return instance
					end

					local result = instanceData[1]
					local instance = instanceData[2]

					instance.Parent = Objects

					return result, instance
				end
			end

			return kData, buttonContainer
		end

		return data, parent
	end

	for _, item in next, clone:GetDescendants() do
		if handler(item, "ZIndex") then
			item.ZIndex = item.ZIndex + sum * 10
		end
	end

	return data, clone
end

return data
