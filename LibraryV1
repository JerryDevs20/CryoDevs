local function updateInstanceProperties(parent, differenceNumber, secondaryInstancePropertiesNumber)
	spawn(function()
		parent.ClipsDescendants = true

		local clone = Prefabs:FindFirstChild("Circle"):Clone()

		clone.Parent = parent
		clone.ZIndex = 1000

		local updateInstancePropertiesNumber = differenceNumber - clone.AbsolutePosition.X
		local difference = secondaryInstancePropertiesNumber - clone.AbsolutePosition.Y

		clone.Position = UDim2.new(0, updateInstancePropertiesNumber, 0, difference)

		local number = 0

		if not (parent.AbsoluteSize.X > parent.AbsoluteSize.Y) then
			if not (parent.AbsoluteSize.X < parent.AbsoluteSize.Y) then
				if parent.AbsoluteSize.X == parent.AbsoluteSize.Y then
					number = parent.AbsoluteSize.X * 1.5
				end
			else
				number = parent.AbsoluteSize.Y * 1.5
			end
		else
			number = parent.AbsoluteSize.X * 1.5
		end

		clone:TweenSizeAndPosition(UDim2.new(0, number, 0, number), UDim2.new(0.5, -number / 2, 0.5, -number / 2), "Out", "Quad", 0.5, false, nil)
		handleInstanceProperties(clone, {
			ImageTransparency = 1
		}, 0.5)
		wait(0.5)
		clone:Destroy()
	end)
end

