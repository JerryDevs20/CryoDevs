local function handleInstanceProperties(item, secondaryArgument, tweenInfoNumber)
	if not tweenInfoNumber then
		tweenInfoNumber = 0.5
	end

	local tweenInfo = TweenInfo.new(tweenInfoNumber, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	TweenService:Create(item, tweenInfo, secondaryArgument):Play()
end
local function handleResult(quotientNumber, secondaryQuotientNumber, alternateQuotientNumber)
	local quotient = quotientNumber / 255
	local resultNumber = secondaryQuotientNumber / 255
	local number = alternateQuotientNumber / 255
	local optionNumber = math.max(quotient, resultNumber, number)
	local differenceNumber = math.min(quotient, resultNumber, number)
	local sum = nil
	local difference = optionNumber - differenceNumber
	local resultOption = optionNumber == 0 and 0 or difference / optionNumber
	local secondaryResultNumber

	if optionNumber ~= differenceNumber then
		if optionNumber ~= quotient then
			if optionNumber ~= resultNumber then
				if optionNumber == number then
					sum = (quotient - resultNumber) / difference + 4
				end
			else
				sum = (number - quotient) / difference + 2
			end
		else
			sum = (resultNumber - number) / difference

			if resultNumber < number then
				sum = sum + 6
			end
		end

		secondaryResultNumber = sum / 6
	else
		secondaryResultNumber = 0
	end

	return secondaryResultNumber, resultOption, optionNumber
end
