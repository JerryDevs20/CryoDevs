					while secondaryFlag and Resizer.Active do
						local vector = new()
						local difference = vector.X - clone.AbsolutePosition.X
						local number = vector.Y - clone.AbsolutePosition.Y

						if not (difference >= capturedFlagData.min_size.X) or not (number >= capturedFlagData.min_size.Y) then
							if not (difference >= capturedFlagData.min_size.X) then
								if not (number >= capturedFlagData.min_size.Y) then
									handleInstanceProperties(clone, {
										Size = UDim2.new(0, capturedFlagData.min_size.X, 0, capturedFlagData.min_size.Y)
									}, capturedFlagData.tween_time)
								else
									handleInstanceProperties(clone, {
										Size = UDim2.new(0, capturedFlagData.min_size.X, 0, number)
									}, capturedFlagData.tween_time)
								end
							else
								handleInstanceProperties(clone, {
									Size = UDim2.new(0, difference, 0, capturedFlagData.min_size.Y)
								}, capturedFlagData.tween_time)
							end
						else
							handleInstanceProperties(clone, {
								Size = UDim2.new(0, difference, 0, number)
							}, capturedFlagData.tween_time)
						end

						RunService.Heartbeat:Wait()
					end
				end
			end)
		end
	end)
